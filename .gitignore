.DS_Store

# Data files — BigQuery is the persistence layer; no raw data in the repo
data/

# Credentials — never commit service account keys
secrets/
*-sa-key.json
*-credentials.json
service-account*.json

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.env

# Claude local settings
.claude/settings.local.json

# External reference material — not part of the repo
Extracció/

# Generated reports — output artifacts, not source code
reports/
website/reports/

# dbt local run artifacts
pipeline/dbt/target/
pipeline/dbt/dbt_packages/
pipeline/dbt/logs/
pipeline/dbt/.user.yml
